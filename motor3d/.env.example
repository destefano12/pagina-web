# Copiar a .env y completar. NUNCA subir .env al repositorio.

# --- dominio público (HTTPS automático con Caddy) ---
DOMINIO=mimotor.duckdns.org
URL_PUBLICA_MODELOS=https://mimotor.duckdns.org/modelos
ORIGENES_PERMITIDOS=https://tu-sitio.netlify.app

# --- base de datos propia del motor ---
POSTGRES_PASSWORD=cambiar-por-una-clave-larga

# --- almacenamiento S3 (SeaweedFS) ---
S3_ENDPOINT=http://almacen:8333
S3_ACCESS_KEY=motor3d
S3_SECRET_KEY=cambiar-por-una-clave-larga-de-40-caracteres
S3_BUCKET_PRIVADO=motor3d-trabajos
S3_BUCKET_PUBLICO=motor3d-modelos

# --- cola ---
REDIS_URL=redis://redis:6379/0

# --- links firmados de vista previa (mínimo 32 caracteres al azar: openssl rand -hex 32) ---
SECRETO_FIRMAS=

# --- autenticación: la misma de la plataforma (Supabase Auth). La anon key es pública. ---
SUPABASE_URL=https://xeajsygiqueyzxemcbxl.supabase.co
SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=   (solo si el proyecto todavía firma con HS256)

# --- motor ---
USAR_GPU=0
# HILOS=4
DENSA_MAX=1600
TEXTURA_MAX=4096
LIMITE_TRABAJO_S=10800

# --- límites ---
MAX_FOTOS=150
MIN_FOTOS=20
MAX_MB_FOTO=20
MAX_TRABAJOS_ACTIVOS=3
MAX_PEDIDOS_MINUTO=240
DIAS_GUARDAR_FOTOS=7

# --- SOLO pruebas automáticas (dejar en 0 en producción) ---
MODO_PRUEBA=0
PRUEBA_SECRETO=
